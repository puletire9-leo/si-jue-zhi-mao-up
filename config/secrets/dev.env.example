# ============================================
# 思觉智贸 - 开发环境密钥模板 (示例)
# 复制本文件为 dev.env, 填入真实开发密钥
# ⛔ 此 .example 文件不放真密钥! dev.env 才是真的
# ============================================

# ── 认证 (≥ 32 字符) ──
# ⚠️ 改密钥会导致现有 JWT 全失效, 用户需要重新登录
# 沿用项目历史值(见 dev.env): sjzm-default-secret-key-must-change-in-production-2024
JWT_SECRET=
SECRET_KEY=

# ── MySQL ──
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── 腾讯云 COS (开发桶) ──
COS_SECRET_ID=
COS_SECRET_KEY=

# ── 卖家精灵 ──
SELLERSPRITE_SECRET_KEY=

# ── 领星开放平台 (数据对接, openapi.lingxing.com) ──
LINGXING_APP_ID=
LINGXING_APP_SECRET=

# 领星 MCP（领星 ERP「AI助手 > 管理MCP」获取，禁止提交真实值）
LINGXING_MCP_URL=
LINGXING_MCP_KEY=

# ── DeepSeek 上游 (仅 ai-center 持有) ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── AI 请求中心内部鉴权 (调用方持有, 不等于 DeepSeek Key) ──
# 生成: openssl rand -hex 32
AI_CENTER_INTERNAL_KEY=

# ── 八爪鱼开放平台 ──
BAZHUAYU_USERNAME=
BAZHUAYU_PASSWORD=

# ── 飞书开放平台（Java sjzm-product 换 tenant_access_token）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 飞书多维表格 App Token（表 ID 仍在 public/*.env）──
OPERATIONS_LOGISTICS_FEISHU_APP_TOKEN=
FINANCE_DAILY_REPORT_FEISHU_APP_TOKEN=

# ── 飞书多维表格连 RDS 只读账号（不要把 RDS_PASSWORD 给飞书）──
FEISHU_RDS_READONLY_USER=
FEISHU_RDS_READONLY_PASSWORD=
