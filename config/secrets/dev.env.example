# ============================================
# 思觉智贸 - 开发环境密钥模板 (示例)
# 复制本文件为 dev.env, 填入真实开发密钥
# ⛔ 此 .example 文件不放真密钥! dev.env 才是真的
# ============================================

# ── 认证 (≥ 32 字符) ──
# ⚠️ 改密钥会导致现有 JWT 全失效, 用户需要重新登录
# 沿用项目历史值(见 dev.env): sjzm-default-secret-key-must-change-in-production-2024
JWT_SECRET=
SECRET_KEY=

# ── MySQL ──
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── 腾讯云 COS (开发桶) ──
COS_SECRET_ID=
COS_SECRET_KEY=

# ── 卖家精灵 ──
SELLERSPRITE_SECRET_KEY=

# ── 领星开放平台 (数据对接, openapi.lingxing.com) ──
LINGXING_APP_ID=
LINGXING_APP_SECRET=

# ── DeepSeek (selection-agent) ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
