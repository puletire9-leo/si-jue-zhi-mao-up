# ============================================
# 思觉智贸 - 生产环境密钥 (敏感)
# 复制本文件为 prod.env, 填入真实生产密钥
# ⛔ prod.env 不进 git
# ============================================

# ── 认证 (≥ 32 字符) ──
JWT_SECRET=
SECRET_KEY=

# ── MySQL ──
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── 腾讯云 COS (生产桶) ──
COS_SECRET_ID=
COS_SECRET_KEY=

# ── 卖家精灵 ──
SELLERSPRITE_SECRET_KEY=

# ── 领星开放平台 (数据对接, openapi.lingxing.com) ──
# AppId/AppSecret 在领星后台「设置 > 全局 > 开放接口」获取
LINGXING_APP_ID=
LINGXING_APP_SECRET=

# ── DeepSeek 上游 (仅 ai-center 持有) ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── AI 请求中心内部鉴权 (调用方持有, 不等于 DeepSeek Key) ──
# 生成: openssl rand -hex 32
AI_CENTER_INTERNAL_KEY=

# ── Nacos 鉴权 (standalone 可空) ──
NACOS_AUTH_TOKEN=
