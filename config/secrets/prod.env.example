# ============================================
# 思觉智贸 - 生产环境密钥 (敏感)
# 复制本文件为 prod.env, 填入真实生产密钥
# ⛔ prod.env 不进 git
# ============================================

# ── 认证 (≥ 32 字符) ──
JWT_SECRET=
SECRET_KEY=

# ── MySQL ──
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ── 腾讯云 COS (生产桶) ──
COS_SECRET_ID=
COS_SECRET_KEY=

# ── 卖家精灵 ──
SELLERSPRITE_SECRET_KEY=

# ── DeepSeek (selection-agent, 生产可空) ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Nacos 鉴权 (standalone 可空) ──
NACOS_AUTH_TOKEN=
