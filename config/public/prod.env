# ============================================
# 思觉智贸 - 生产环境配置 (非敏感)
# 此文件进 git, 密钥请放 config/secrets/prod.env
# ============================================

# ── 环境 ──
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── MySQL ──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=sijuelishi
MYSQL_USER=sijue
MYSQL_USERNAME=sijue

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# ── 腾讯云 COS (生产桶) ──
COS_ENABLED=true
COS_BUCKET=sijuelishi-1328246743
COS_REGION=ap-guangzhou

# ── 领星 COS ──
LINGXING_COS_BUCKET=lingxing-1328246743
LINGXING_COS_REGION=ap-guangzhou
LINGXING_COS_PREFIX=uploads/

# ── Nacos ──
NACOS_ENABLED=true
NACOS_SERVER_ADDR=nacos:8848

# ── 性能 ──
RATE_LIMIT_ENABLED=true
SLOW_REQUEST_THRESHOLD=5
REQUEST_TIMEOUT=30
JWT_EXPIRATION=86400000

# ── CORS (生产) ──
CORS_ORIGINS=["http://localhost"]

# ── 八爪鱼自动采集 (非敏感) ──
# cron 6 段式 (秒 分 时 日 月 周)，默认周一 03:00
BAZHUAYU_CRON=0 0 3 * * MON
BAZHUAYU_BASE_URL=https://openapi.bazhuayu.com
# 单次 drain 上限（防失控）；0=不限。首次清历史积压可临时设 0 或大值
BAZHUAYU_DRAIN_MAX_ROWS=100000
# 任务组→站点→任务ID 映射（榜单采集榜单数据三国 US/UK/DE）
# 注：以图识图任务(图像识别)非本流水线，不纳入 —
#   以图识图 US 6ec0c0a2-c394-3397-78f5-b2eaed8fab78 / UK 5c2ae37f-3128-4c82-84d6-70ad6d3d3655 / DE 3270566a-1206-4992-b466-949891038c55
BAZHUAYU_TASKGROUP_MAPPING={"bangdan":{"US":"d2a29423-ed46-49cd-8064-36b58754ef85","DE":"9a7ce21a-5093-188b-8669-3913d644af9e","UK":"6bf068a0-57ee-4ed6-aa1c-1ebabcd3780a"}}
