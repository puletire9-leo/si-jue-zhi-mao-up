# ============================================
# 思觉智贸 - 生产环境配置 (非敏感)
# 此文件进 git, 密钥请放 config/secrets/prod.env
# ============================================

# ── 环境 ──
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── MySQL ──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=sijuelishi
MYSQL_USER=sijue
MYSQL_USERNAME=sijue

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1

# ── 腾讯云 COS (生产桶) ──
COS_ENABLED=true
COS_BUCKET=sijuelishi-1328246743
COS_REGION=ap-guangzhou

# ── 领星 COS ──
LINGXING_COS_BUCKET=lingxing-1328246743
LINGXING_COS_REGION=ap-guangzhou
LINGXING_COS_PREFIX=uploads/

# ── Nacos ──
NACOS_ENABLED=true
NACOS_SERVER_ADDR=nacos:8848

# ── 性能 ──
RATE_LIMIT_ENABLED=true
SLOW_REQUEST_THRESHOLD=5
REQUEST_TIMEOUT=30
JWT_EXPIRATION=86400000

# ── CORS (生产) ──
CORS_ORIGINS=["http://localhost"]
