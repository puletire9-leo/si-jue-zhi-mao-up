# ============================================
# 思觉智贸 - 开发环境配置 (非敏感)
# 此文件进 git, 密钥请放 config/secrets/dev.env
# ============================================

# ── 环境 ──
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── MySQL ──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=sijuelishi_dev
MYSQL_USER=sijue
MYSQL_USERNAME=sijue
MYSQL_PORT_EXTERNAL=3410

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Qdrant ──
QDRANT_PORT=6333

# ── 服务端口 ──
BACKEND_PORT=18090
FRONTEND_PORT=5175

# ── 腾讯云 COS (开发桶) ──
COS_ENABLED=true
COS_BUCKET=sijuelishi-dev-1328246743
COS_REGION=ap-guangzhou

# ── 领星 COS ──
LINGXING_COS_BUCKET=lingxing-1328246743
LINGXING_COS_REGION=ap-guangzhou
LINGXING_COS_PREFIX=uploads/

# ── Nacos ──
NACOS_ENABLED=false

# ── 性能 ──
RATE_LIMIT_ENABLED=false
JWT_EXPIRATION=86400000

# ── CORS (本地开发) ──
CORS_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175","http://localhost:5173","http://127.0.0.1:5173","http://localhost:80"]

# ── 八爪鱼自动采集 (非敏感) ──
# cron 6 段式(秒 分 时 日 月 周)；开发默认禁用定时(Spring "-")，靠手动 /trigger 测试
BAZHUAYU_CRON=-
BAZHUAYU_BASE_URL=https://openapi.bazhuayu.com
# 单次 drain 上限：0=不限；先验证链路通再放量（markexported 不可逆，谨慎）
BAZHUAYU_DRAIN_MAX_ROWS=0
# 功能→站点→任务ID 映射。榜单(bangdan)走完整一条龙;以图识图(yitushitu)本期仅启停/监控
BAZHUAYU_TASKGROUP_MAPPING={"bangdan":{"US":"d2a29423-ed46-49cd-8064-36b58754ef85","DE":"9a7ce21a-5093-188b-8669-3913d644af9e","UK":"6bf068a0-57ee-4ed6-aa1c-1ebabcd3780a"},"yitushitu":{"US":"6ec0c0a2-c394-3397-78f5-b2eaed8fab78","UK":"5c2ae37f-3128-4c82-84d6-70ad6d3d3655","DE":"3270566a-1206-4992-b466-949891038c55"}}
# 采集线程池:6个任务可并行
BAZHUAYU_EXECUTOR_CORE=3
BAZHUAYU_EXECUTOR_MAX=6
BAZHUAYU_EXECUTOR_QUEUE=12
