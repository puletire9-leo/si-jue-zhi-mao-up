# ============================================
# 思觉智贸 - 开发环境配置 (非敏感)
# 此文件进 git, 密钥请放 config/secrets/dev.env
# ============================================

# ── 环境 ──
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── MySQL ──
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=sijuelishi_dev
MYSQL_USER=sijue
MYSQL_PORT_EXTERNAL=3307

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Qdrant ──
QDRANT_PORT=6333

# ── 服务端口 ──
BACKEND_PORT=8080
FRONTEND_PORT=80

# ── 腾讯云 COS (开发桶) ──
COS_ENABLED=true
COS_BUCKET=sijuelishi-dev-1328246743
COS_REGION=ap-guangzhou

# ── 领星 COS ──
LINGXING_COS_BUCKET=lingxing-1328246743
LINGXING_COS_REGION=ap-guangzhou
LINGXING_COS_PREFIX=uploads/

# ── Nacos ──
NACOS_ENABLED=false

# ── 性能 ──
RATE_LIMIT_ENABLED=false
JWT_EXPIRATION=86400000

# ── CORS (本地开发) ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://127.0.0.1:5173"]
