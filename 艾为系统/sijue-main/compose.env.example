# Docker 部署配置：复制为 compose.env 后按需修改。MySQL/Redis 使用宿主机已有。
# 镜像由 CI 构建推送，此处填镜像地址。

# ---------- 镜像地址（CI 推送至阿里云 ACR，与阿里云控制台仓库名一致）----------
MIDWAY_IMAGE=crpi-646e65hvjad58bp2.cn-guangzhou.personal.cr.aliyuncs.com/sijue/web-backend:main
VUE_IMAGE=crpi-646e65hvjad58bp2.cn-guangzhou.personal.cr.aliyuncs.com/sijue/web-front:main
KEYWORD_RESEARCH_GO_IMAGE=crpi-646e65hvjad58bp2.cn-guangzhou.personal.cr.aliyuncs.com/sijue/keyword-research-go:main

# ---------- 宿主机目录 ----------
UPLOADS_HOST_PATH=/web/amz-listing-optimiser/cool-admin-midway/public/uploads

# ---------- 端口（docker compose 映射；Midway 容器内仍监听 8001）----------
APP_PORT=8001
FRONTEND_PORT=80

# ---------- 后端连接宿主机 MySQL/Redis ----------
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=listing_optimiser

REDIS_HOST=host.docker.internal
REDIS_PORT=6379


# ---------- 设计图需 AI（OpenAI 兼容接口）----------
# 后端会从这些环境变量中读取配置；为空则不会启用 AI 功能。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-5-mini

# ---------- LangSmith（@langchain/* 链路追踪，与 config.local 一致）----------
# 不配 LANGSMITH_API_KEY 则生产不开启 trace
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=sijue-prod
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
# 可选：自建 LangSmith 端点
# LANGSMITH_ENDPOINT=

# ---------- 百度翻译（图需 AI 抽原文→中文等，非中文案失焦多语言）----------
# 与 config.default / config.prod 中 baiduFanyi 一致；密钥勿提交仓库。
# 本地复制本文件为 compose.env 后填写；Docker 通过 env_file 注入。
# 不用 Docker、直接 midway dev 时：在启动前 export 同名变量即可。
BAIDU_FANYI_APP_ID=
BAIDU_FANYI_SECRET=

# 图需中文案失焦自动翻译多语言：复用上方 OPENAI_API_KEY + OPENAI_BASE_URL（智增增），模型默认 qwen-mt-flash
# QWEN_MT_MODEL=qwen-mt-flash

# ---------- BullMQ + Bull Board（运行态任务可视化）----------
# 说明：
# 1) 仅运行态观测，不入业务库
# 2) compose 默认暴露 8011 端口，访问地址：http://<host>:8011/ops/queue
# 3) 这里仅保留启用开关 + 面板账号密码，其它参数走代码默认值
DESIGN_JOB_QUEUE_ENABLED=1
DESIGN_JOB_BOARD_AUTH_USER=ops
DESIGN_JOB_BOARD_AUTH_PASS=please_change_me

# ---------- AI Listing Task（关键词调研 + LangGraph）----------
AI_LISTING_TASK_QUEUE_ENABLED=1
AI_LISTING_TASK_MAX_ATTEMPTS=3
AI_LISTING_TASK_BACKOFF_MS=5000,15000,45000
# 整单 BullMQ 超时（含双 lane 关键词 + LLM）；默认代码 10min 偏短
AI_LISTING_TASK_QUEUE_TIMEOUT_MS=3600000
AI_LISTING_USER_SYSTEM_MODEL_NAME=gpt-5-mini

# Midway 访问 Go API（容器内网）
KEYWORD_RESEARCH_GO_BASE_URL=http://keyword-research-api:8099
KEYWORD_RESEARCH_GO_TIMEOUT_MS=30000
KEYWORD_RESEARCH_GO_POLL_INTERVAL_MS=2000

# ---------- Go keyword-research-api / worker（env_file 直读，变量名与二进制一致）----------
# 监听端口在 docker-compose 写死 8099（勿与上方 APP_PORT=8001 共用同名）
REDIS_ADDR=host.docker.internal:6379
REDIS_DB=14
REDIS_PASSWORD=
USE_MOCK_EXTERNALS=false
OXYLABS_API_URL=https://realtime.oxylabs.io/v1/queries
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_MAX_CONCURRENT=4
OXYLABS_TIMEOUT_MS=45000
OXYLABS_SEMAPHORE_WAIT_MS=600000
OXYLABS_SEMAPHORE_SLOT_TTL_SEC=120
IMAGESEARCH_ACCESS_KEY_ID=
IMAGESEARCH_ACCESS_KEY_SECRET=
IMAGESEARCH_ENDPOINT=imagesearch.cn-shenzhen.aliyuncs.com
IMAGESEARCH_REGION_ID=cn-shenzhen
IMAGESEARCH_INSTANCE_NAME=
IMAGESEARCH_TIMEOUT_MS=10000
IMAGESEARCH_MAX_RETRIES=2
KEYWORD_CONCURRENCY=6
IMAGE_CONCURRENCY=3
TOP_N_PER_MARKET=30
SCORE2_THRESHOLD=0
MAX_IMAGES_PER_KEYWORD=8
IMAGE_RATE_LIMIT_PER_SEC=10

# 本地 LangGraph API
LANGGRAPH_BASE_URL=http://host.docker.internal:8123
LANGGRAPH_API_KEY=
LANGGRAPH_TIMEOUT_MS=45000
LANGGRAPH_POLL_INTERVAL_MS=2000

# ---------- 内网素材服务器（dufs HTTP 文件服务，通过 frps 反向接入）----------
# 用法：
# 1) 内网 Windows 机跑 dufs（根目录挂整盘 D:\）+ frpc，把本地 9000 反向暴露到云端 frps:9000
# 2) midway 后端通过 ASSET_INTERNAL_BASE 访问（容器内可走 host.docker.internal）
# 3) 浏览器通过 /admin/app/asset/file?token=... 走 midway 转发取文件（不需要 PUBLIC_ENDPOINT）
ASSET_INTERNAL_BASE=http://host.docker.internal:9000
ASSET_USERNAME=sijue_admin
ASSET_PASSWORD=please_change_me
# HMAC 签名密钥，必须是足够长的随机串。生成：openssl rand -hex 32
ASSET_SIGN_SECRET=please_replace_with_a_64_char_random_string
ASSET_SIGN_EXPIRE=3600

# ---------- DingTalk work notices ----------
# BSR reserve notices are sent to users whose role name or label contains "运营" or "operator".
# Their mobile numbers are read from base_sys_user.phone.
DINGTALK_ENABLED=true
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_ADMIN_BASE_URL=

# ---------- frps（内网素材服务器反向隧道接入）----------
# 1) 云端 compose 启 frps；内网那台美工素材机跑 frpc 主动连过来
# 2) FRPS_TOKEN 必须够长够随机，frpc 端用同样的 token
# 3) Dashboard：http://<server>:7500，用 FRPS_DASHBOARD_USER / PASSWORD 登录
# 4) 端口范围（9000-9010, 7001-7099）已在 docker-compose.yml + frps.toml 中固定；
#    要改的话两处都得改
FRPS_TOKEN=please_change_me_to_a_long_random_string
FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=please_change_me
FRPS_BIND_PORT=7000
FRPS_DASHBOARD_PORT=7500
