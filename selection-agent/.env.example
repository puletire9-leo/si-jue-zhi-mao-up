# ── 选品分析 Agent 环境变量 ──

# LLM 配置
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_TIMEOUT=120

# Java 后端
JAVA_BASE_URL=http://localhost:8002
JAVA_MAX_RETRIES=3
JAVA_RETRY_DELAY=1.0

# 服务配置
HOST=0.0.0.0
PORT=8011
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:5175,http://localhost:5173

# 并发控制
MAX_CONCURRENT_SUBS=3
