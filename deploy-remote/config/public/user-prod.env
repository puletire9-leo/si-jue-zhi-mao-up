# RDS 登录库（ai_platform）。同一实例 rm-bp1ft07y37887765cqo，公网 IP 是 101.37.51.239。
# 密码在 secrets/user-prod.env 的 USER_MYSQL_PASSWORD。
# 加载：java-user、backend、celery。java-product 不读这个文件。
USER_MYSQL_HOST=rm-bp1ft07y37887765cqo.mysql.rds.aliyuncs.com
USER_MYSQL_PORT=3306
USER_MYSQL_DATABASE=ai_platform
USER_MYSQL_USERNAME=ai_platform_app

# ---------- 后端连接宿主机 MySQL/Redis ----------
# 与 prod.env 相同。java-product 只读 prod.env，所以 prod.env 里也必须有这组值。
# 密码在 secrets/prod.env 和 secrets/user-prod.env 的 MYSQL_PASSWORD。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_USERNAME=root
MYSQL_DATABASE=ai-selection
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=2
REDIS_DATABASE=2
