# 思觉智贸 - 远程部署非敏感配置
# 改完必须 recreate 容器才会生效：docker compose up -d --force-recreate <服务>

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# 对方宿主机已有 MySQL（不是 compose 里的 prod-mysql）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ai-selection
MYSQL_USER=root
MYSQL_USERNAME=root
MYSQL_MAX_CONNECTIONS=60
MYSQL_BINLOG_EXPIRE_SECONDS=604800
MYSQL_PRODUCT_POOL_MIN_IDLE=3
MYSQL_PRODUCT_POOL_MAX_SIZE=15
MYSQL_USER_POOL_MIN_IDLE=2
MYSQL_USER_POOL_MAX_SIZE=5
MYSQL_POOL_CONNECTION_TIMEOUT_MS=5000
MYSQL_POOL_MIN_SIZE=3
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=5
MYSQL_POOL_TIMEOUT=5
MYSQL_WORKER_POOL_MIN_SIZE=1
MYSQL_WORKER_POOL_SIZE=2
MYSQL_WORKER_MAX_OVERFLOW=0
DB_HEAVY_QUERY_MAX_CONCURRENCY=2
DB_EXPORT_MAX_CONCURRENCY=1
DB_HEAVY_WRITE_MAX_CONCURRENCY=1
DB_WORKLOAD_ACQUIRE_TIMEOUT_MS=1000

# RDS 领星/财务/运营库（sijuelishi）。和 USER_MYSQL_* 同一台实例，这里用公网 IP。
# 密码在 secrets/prod.env 的 RDS_PASSWORD。只有 java-product 用 RDS_*。
# MYSQL_* 是宿主机 MySQL 库 ai-selection，不要和 RDS 搞混。
RDS_HOST=101.37.51.239
RDS_PORT=3306
RDS_DATABASE=sijuelishi
RDS_USERNAME=ai_platform_app
RDS_POOL_MIN_IDLE=2
RDS_POOL_MAX_SIZE=8

# 对方宿主机 Redis，2 号库，不占用已有业务的 0/1
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=2
REDIS_DATABASE=2
REDISSON_ADDRESS=redis://host.docker.internal:6379
REDISSON_DATABASE=2
CELERY_BROKER_URL=redis://host.docker.internal:6379/2
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/2

COS_ENABLED=true
COS_BUCKET=sijuelishi-1328246743
COS_REGION=ap-guangzhou

LINGXING_COS_BUCKET=lingxing-1328246743
LINGXING_COS_REGION=ap-guangzhou
LINGXING_COS_PREFIX=uploads/
LINGXING_SCHEDULED_ENABLED=true

# App Token 在 secrets/prod.env：OPERATIONS_LOGISTICS_FEISHU_APP_TOKEN / FINANCE_DAILY_REPORT_FEISHU_APP_TOKEN
OPERATIONS_LOGISTICS_FEISHU_TABLE_ID=tbl7C6n5MyLwXOep
FINANCE_DAILY_REPORT_TABLE_TOTAL=tblBFoTfGn9VyCHh
FINANCE_DAILY_REPORT_TABLE_OPERATIONS=tblolIGQ0OO8DQ8M
FINANCE_DAILY_REPORT_TABLE_DEVELOPER=tblJi57lYfZ9n0Ck
FINANCE_DAILY_REPORT_TABLE_NONSTANDARD=tblEySX0Doew1yQp
FINANCE_DAILY_REPORT_TABLE_LISTING_TIME=tbliN1K61PN33FEC

NACOS_ENABLED=true
NACOS_SERVER_ADDR=nacos:8848

AI_CENTER_BASE_URL=http://ai-center:8012
AI_CENTER_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-reasoner,deepseek-chat

RATE_LIMIT_ENABLED=true
SLOW_REQUEST_THRESHOLD=5
REQUEST_TIMEOUT=30
JWT_EXPIRATION=86400000

# 有公网域名后改成 ["https://你的域名"]，然后 recreate backend / java / gateway，并 restart frontend
CORS_ORIGINS=["http://localhost"]

BAZHUAYU_CRON=0 0 6 * * 1,3
BAZHUAYU_BASE_URL=https://openapi.bazhuayu.com
BAZHUAYU_DRAIN_MAX_ROWS=0
BAZHUAYU_TASKGROUP_MAPPING={"bangdan":{"US":"d2a29423-ed46-49cd-8064-36b58754ef85","DE":"9a7ce21a-5093-188b-8669-3913d644af9e","UK":"6bf068a0-57ee-4ed6-aa1c-1ebabcd3780a"},"yitushitu":{"US":"6ec0c0a2-c394-3397-78f5-b2eaed8fab78","UK":"5c2ae37f-3128-4c82-84d6-70ad6d3d3655","DE":"3270566a-1206-4992-b466-949891038c55"}}
BAZHUAYU_EXECUTOR_CORE=3
BAZHUAYU_EXECUTOR_MAX=6
BAZHUAYU_EXECUTOR_QUEUE=12
