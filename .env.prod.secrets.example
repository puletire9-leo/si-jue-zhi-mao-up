# ============================================
# 思觉智贸 - 生产环境密钥（敏感）
# 部署时复制为 .env.prod.secrets 并填入真实值
# 此文件不得提交到 Git
# ============================================

# 认证（JWT_SECRET 必须 >= 32 字符，否则 HMAC-SHA256 会报错）
JWT_SECRET=
SECRET_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=

# 卖家精灵
SELLERSPRITE_SECRET_KEY=

# Nacos 鉴权（可选，standalone 模式下可留空）
NACOS_AUTH_TOKEN=
